{
  "source": {
    "include": [
      "src"
    ],
    "includePattern": ".+\\.js(x)?$",
    "exclude": [
      "node_modules",
      "build",
      "dist"
    ],
    "excludePattern": "(node_modules/|docs/|build/|dist/|\\.test\\.|\\__tests__/)"
  },
  "plugins": [
    "plugins/markdown",
    "plugins/summarize"
  ],
  "opts": {
    "recurse": true,
    "destination": "./docs/",
    "template": "node_modules/better-docs"
  },
  "tags": {
    "allowUnknownTags": true,
    "dictionaries": ["jsdoc", "closure"]
  },
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": false,
    "better-docs": {
      "name": "Employee Management System",
      "title": "Employee Management System - API Documentation",
      "hideGenerator": true,
      "navigation": [
        {
          "label": "GitHub",
          "href": "https://github.com/jorgecruz-aor-paj/projeto-3-trimestre"
        }
      ]
    }
  },
  "markdown": {
    "hardwrap": true,
    "idInHeadings": true
  }
}